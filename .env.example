# Secrets live in a real .env (chmod 600), never committed. Copy this file and fill in values.

# --- Flask ---
SECRET_KEY=                      # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_COOKIE_SECURE=true        # set to false only for local http:// development
TRUST_PROXY=true                  # true when behind nginx; false for local `flask run`

# --- Database / queue ---
# When running via `docker compose up` (recommended), these resolve by compose service
# name: DATABASE_URL host is `postgres`, REDIS_URL/RATELIMIT_STORAGE_URI host is `redis`.
# Running the app directly on the host instead? Point these at 127.0.0.1 (and start
# `docker compose up postgres redis` for just the data stores).
POSTGRES_PASSWORD=                # required by the postgres service in compose.yaml
DATABASE_URL=postgresql+psycopg://ai_interviewer:CHANGE_ME@postgres:5432/ai_interviewer
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1

# --- Voice pipeline: Deepgram (STT) + OpenAI (interviewer LLM) + Sarvam (TTS) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

OPENAI_API_KEY=
OPENAI_PROVIDER=openai            # openai | azure
# --- Azure OpenAI (only used when OPENAI_PROVIDER=azure) ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21
# Model name sent to the API. For plain OpenAI this is the model id; under
# OPENAI_PROVIDER=azure set it to your AZURE_OPENAI_DEPLOYMENT (same value).
INTERVIEWER_MODEL=gpt-4.1-mini

SARVAM_API_KEY=
SARVAM_SPEAKER=anushka
SARVAM_MODEL=bulbul:v2
SARVAM_LANGUAGE_CODE=en-IN

# Bind address for worker/voice_session.py (the browser-facing voice WebSocket). In
# production, and when running via `docker compose up`, this sits behind nginx (see
# deploy/nginx.conf or deploy/nginx.compose.conf, location /voice/) so it only needs to be
# reachable from the proxy container/host, not the public internet.
VOICE_WS_HOST=0.0.0.0
VOICE_WS_PORT=8765

# Base ws:// URL the *browser* uses to reach the voice worker directly. Only needed if
# running Flask's bare dev server with NO reverse proxy in front (e.g. `flask run` on the
# host, outside docker compose) -- then the browser has no way to resolve the worker's
# host:port from the page's own origin. Leave empty when running via `docker compose up`
# (nginx proxies /voice/ on the same origin) or in production.
VOICE_WS_PUBLIC_URL=

# --- Evaluator (post-interview scoring) ---
EVALUATOR_PROVIDER=openai         # openai | bedrock
EVALUATOR_MODEL=gpt-4.1-mini      # under OPENAI_PROVIDER=azure set to your AZURE_OPENAI_DEPLOYMENT
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0   # required if EVALUATOR_PROVIDER=bedrock
AWS_REGION=ap-south-1             # used only when EVALUATOR_PROVIDER=bedrock (uses instance role)

# --- GitHub ---
# Fine-grained PAT with NO repository permissions (public read + higher rate limit only).
GITHUB_TOKEN=

# --- Limits / cost guards ---
MAX_CALL_SECONDS=900
MAX_INTERVIEWS_PER_IP_PER_DAY=3
MAX_INTERVIEWS_PER_DAY=100
RETENTION_DAYS=30
