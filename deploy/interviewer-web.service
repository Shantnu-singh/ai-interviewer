# Run with: `.venv/bin/gunicorn` via systemd. Place in /etc/systemd/system/.
[Unit]
Description=AI Interviewer - web (gunicorn)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=ai-interviewer
Group=ai-interviewer
WorkingDirectory=/opt/ai-interviewer
EnvironmentFile=/opt/ai-interviewer/.env
ExecStart=/opt/ai-interviewer/.venv/bin/gunicorn -w 3 -k gthread --threads 4 \
    -b 127.0.0.1:8000 --access-logfile - wsgi:app
Restart=always
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ai-interviewer
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
